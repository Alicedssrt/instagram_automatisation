# Copier ce fichier en .env pour un usage local (jamais committer .env)

# Instagram Business Account ID (recupere via Graph API Explorer)
IG_USER_ID=

# Token d'acces Meta longue duree (~60 jours, a renouveler)
IG_ACCESS_TOKEN=

# Version de l'API Graph
GRAPH_API_VERSION=v21.0

# Fuseau horaire d'interpretation des dates/heures du CSV
TIMEZONE=Europe/Paris

# Strategie d'hebergement des images ("github_raw" en V1)
IMAGE_HOST=github_raw

# owner/repo GitHub servant les images (fourni automatiquement en CI)
GITHUB_REPOSITORY=

# Branche servant les images
GITHUB_BRANCH=main

# Chemin du calendrier CSV
CALENDAR_PATH=data/calendrier.csv

# 1 = simulation (aucun appel API, CSV non modifie), 0 = execution reelle
DRY_RUN=1

# Garde-fou anti rate-limit Meta (25 publications / 24h max)
MAX_POSTS_PER_RUN=25
